            "exec": [
              "// [Snippets] Status code: Code is 200\r",
              "pm.test(\"응답 상태 코드가 200인지 검증\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "// [Snippets] Response body: JSON value check\r",
              "pm.test(\"응답의 id 값이 요청한 POSTID와 일치하는지 확인\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.eql(Number(pm.iterationData.get(\"POSTID\")));\r",
              "});\r",
              "// [Snippets] Response time is less than 200ms\r",
              "pm.test(\"응답 시간이 1000ms 이내인지 확인\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(200);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
